{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://diputat.local/schemas/official.schema.json",
  "title": "Official",
  "description": "Схема для публічної особи (депутата, посадовця)",
  "type": "object",
  "required": ["_id", "name", "position"],
  "properties": {
    "_id": {
      "type": "string",
      "description": "Унікальний ідентифікатор"
    },
    "name": {
      "type": "string",
      "description": "Повне ім'я особи"
    },
    "position": {
      "type": "string",
      "description": "Посада"
    },
    "party": {
      "type": "string",
      "description": "Політична партія"
    },
    "contacts": {
      "type": "object",
      "properties": {
        "social": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "platform": {
                "type": "string",
                "enum": ["facebook", "twitter", "instagram", "telegram", "youtube"]
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "handle": {
                "type": "string"
              }
            }
          }
        },
        "official": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["email", "phone", "website"]
              },
              "value": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "bio": {
      "type": "string",
      "description": "Коротка біографія"
    },
    "photo_url": {
      "type": "string",
      "format": "uri",
      "description": "URL фото"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "description": "Джерело даних"
        }
      }
    }
  }
}
